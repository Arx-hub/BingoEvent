# Apache HTTP Server Configuration for Bingo Event Server Deployment
# Place this file at: /etc/httpd/conf.d/bingo-event.conf

# Proxy to API
<Proxy http://localhost:5000/api/>
    ProxySet connectiontimeout=60
    ProxySet timeout=60
</Proxy>

<VirtualHost *:80>
    ServerName _

    # Security headers
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"

    # Guest App
    Alias /guest/ /var/www/bingo/guest/

    <Directory "/var/www/bingo/guest/">
        Options Indexes FollowSymLinks
        AllowOverride None
        Require all granted

        # SPA routing
        RewriteEngine On
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteRule . /guest/index.html [L]

        # No cache for index.html
        <Files "index.html">
            Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        </Files>
    </Directory>

    # Cache static assets for guest
    <Location "/guest/assets/">
        ExpiresActive On
        ExpiresDefault "access plus 30 days"
        Header set Cache-Control "public, immutable"
    </Location>
    <Location "/guest/fonts/">
        ExpiresActive On
        ExpiresDefault "access plus 30 days"
        Header set Cache-Control "public, immutable"
    </Location>

    # Admin App
    Alias /admin/ /var/www/bingo/admin/

    <Directory "/var/www/bingo/admin/">
        Options Indexes FollowSymLinks
        AllowOverride None
        Require all granted

        # SPA routing
        RewriteEngine On
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteRule . /admin/index.html [L]

        # No cache for index.html
        <Files "index.html">
            Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        </Files>
    </Directory>

    # Cache static assets for admin
    <Location "/admin/assets/">
        ExpiresActive On
        ExpiresDefault "access plus 30 days"
        Header set Cache-Control "public, immutable"
    </Location>
    <Location "/admin/fonts/">
        ExpiresActive On
        ExpiresDefault "access plus 30 days"
        Header set Cache-Control "public, immutable"
    </Location>

    # API Proxy
    ProxyPass /api/ http://localhost:5000/api/
    ProxyPassReverse /api/ http://localhost:5000/api/

    # Root - redirect to guest app
    Redirect permanent / /guest/

    # Deny access to hidden files
    <FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak)$">
        Require all denied
    </FilesMatch>

    # Compression
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/plain
        AddOutputFilterByType DEFLATE text/html
        AddOutputFilterByType DEFLATE text/xml
        AddOutputFilterByType DEFLATE text/css
        AddOutputFilterByType DEFLATE application/xml
        AddOutputFilterByType DEFLATE application/xhtml+xml
        AddOutputFilterByType DEFLATE application/rss+xml
        AddOutputFilterByType DEFLATE application/javascript
        AddOutputFilterByType DEFLATE application/x-javascript
        AddOutputFilterByType DEFLATE application/json
    </IfModule>

</VirtualHost>
    }
}

# HTTP to HTTPS redirect (if using SSL)
# Uncomment and configure if you have an SSL certificate
#
# server {
#     listen 80;
#     listen [::]:80;
#     server_name _;
#     return 301 https://$host$request_uri;
# }
#
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name _;
#
#     ssl_certificate /path/to/certificate.crt;
#     ssl_certificate_key /path/to/private.key;
#
#     # ... rest of configuration from above ...
# }

# Enable this site:
# sudo ln -s /etc/nginx/sites-available/bingo-event /etc/nginx/sites-enabled/
# sudo systemctl test nginx
# sudo systemctl restart nginx
